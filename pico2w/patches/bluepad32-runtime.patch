+    // Promote a level-0 legacy ACL unless the application is still preparing
+    // explicit pairing. Do not repeat this request for level-2 services: some
+    // 8BitDo controllers close their HID interrupt channel in that case.
+    if (uni_bt_get_gap_security_level() == 0 && !bt_defer_security_request)
+        gap_request_security_level(handle, LEVEL_2);
